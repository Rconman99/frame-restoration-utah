{
  "$comment": "Config for scripts/frame-guards.mjs. Market lists are copied from each Frame market repo's own canonical data (see markets.foreign[].source). Public identifiers only; no secrets.",
  "baseline": "scripts/frame-guards.baseline.json",
  "served": {
    "$comment": "Static site deployed by Vercel from the repo root: served = every git-tracked file Vercel uploads (git ls-files minus .vercelignore, which includes its data/* re-includes) with a text extension, minus records/tooling prefixes below. Internal-but-deployed pages (dashboard/, leads.html, seo-report.html) ARE served and are scanned.",
    "vercelignore": true,
    "excludePrefixes": [
      "docs/",
      "archive/",
      "screenshots/",
      ".github/",
      "scripts/",
      "tests/",
      "qa/",
      "supabase/",
      "CODEOWNERS",
      "node_modules/"
    ]
  },
  "nap": {
    "$comment": "Canonical NAP source; sourceMustContain makes the gate fail if the source changes without this config.",
    "source": "data/route-factory/business.json",
    "sourceMustContain": [
      "\"brand\": \"Frame Restoration Utah\"",
      "\"legal_entity\": \"Frame Restoration Utah LLC\"",
      "\"public_phone_display\": \"435-292-8802\"",
      "\"street\": \"142 S Main St\"",
      "435-302-4422"
    ],
