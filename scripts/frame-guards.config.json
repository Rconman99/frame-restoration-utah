  "noRyan": {
    "$comment": "Ryan never appears on customer pages. No personal phone is listed: no file in this repo identifies one as Ryan's, and none is invented.",
    "patterns": [
      {
        "label": "Ryan surname",
        "regex": "(?<![A-Za-z])Conwell(?![A-Za-z])",
        "flags": "gi"
      },
      {
        "label": "Ryan personal email",
        "regex": "ryanconwell99@gmail\\.com",
        "flags": "gi"
      },
      {
        "label": "Ryan personal email",
        "regex": "rconman99@gmail\\.com",
        "flags": "gi"
      },
      {
        "label": "RC Digital attribution",
        "regex": "(?<![A-Za-z])RC[ -]?Digital(?![A-Za-z])",
        "flags": "gi"
      }
    ]
  },
  "deadGbp": {
    "$comment": "Google Business \"g.co/kgs/...\" share links: Site QA found them dead on Utah and Texas (2026-10-18). Opaque redirects with no stable target, so the whole class is denied. Use the maps?cid= listing URL from the canonical source instead. Static: no network calls.",
    "patterns": [
      {
        "label": "dead g.co/kgs Google share link",
        "regex": "g\\.co/kgs/[A-Za-z0-9_-]+",
        "flags": "gi"
      }
    ]
