.vercel

# Local environment files may contain short-lived credentials; never track them.
.env*
!.env.example
!.env.sample
images-stock-backup/
node_modules/
__pycache__/
*.pyc
tmp-*/

# Local backup folders (not deployed)
assets/_backup-pre-enhancement-*/

# Supabase CLI cache (machine-local, never commit)
supabase/.temp/

# Traffic + signal snapshots (refreshed via npm run blog:traffic; contain PII from leads table)
data/traffic-snapshot.json
data/weekly-reports/
data/reddit-signals-by-city.json
data/weather-event-signals.json

# Owner-view GBP source transcriptions/screenshots are private inputs; commit only the sanitized receipt.
data/private-owner-evidence/
