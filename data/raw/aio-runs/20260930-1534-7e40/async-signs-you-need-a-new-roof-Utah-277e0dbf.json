  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Signs you need a new roof in Utah include curling or missing shingles, excessive granule loss in your gutters, and water stains on your ceiling or attic deck.",
        "snippet_highlighted_words": [
          "curling or missing shingles, excessive granule loss in your gutters, and water stains on your ceiling or attic deck"
        ]
      },
      {
        "type": "heading",
        "snippet": "Exterior Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Curling or buckling shingles: Shingles that do not lie flat mean moisture damage or old age."
          },
          {
            "snippet": "Missing or cracked shingles: High winds and heavy winter snow loads can tear or break shingles."
          },
          {
            "snippet": "Granule buildup: Finding dark, sand-like granules in your downspouts means your shingles are losing their protective layer."
          },
          {
            "snippet": "Widespread moss or algae: Thick growth traps moisture against the roof, speeding up shingle rot during Utah's freeze-thaw cycles."
          },
          {
            "snippet": "Damaged flashing: Rust or gaps around chimneys, skylights, and vents let water seep inside."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Interior and Structural Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Ceiling and wall stains: Dark rings or peeling paint near exterior walls point to an active leak."
          },
          {
            "snippet": "Attic issues: Musty smells, wet insulation, or daylight coming through the roof deck mean serious trouble."
          },
          {
            "snippet": "Sagging rooflines: A drooping roof suggests structural weakness in the framing."
          },
          {
            "snippet": "Age over 20 years: Utah\u2019s intense summer UV rays, heavy snow, and high winds wear out standard asphalt roofs within 15 to 20 years."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you want, tell me:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "How is your current roof?"
          },
          {
            "snippet": "Do you notice any leaks inside right now?"
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "I can help you estimate costs or decide between repair and replacement."
      }
    ],
