      {
        "type": "paragraph",
        "snippet": "A roof that is more than 20 years old, shows widespread curling or missing shingles, or drops heavy granules into gutters usually needs replacement.",
        "snippet_highlighted_words": [
          "A roof that is more than 20 years old, shows widespread curling or missing shingles, or drops heavy granules into gutters"
        ],
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Key Warning Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Age over 20 years: Standard asphalt shingle roofs reach the end of their lifespan around two decades, especially under heavy snow and rapid freeze-thaw cycles."
          },
          {
            "snippet": "Curling and buckling:\nEdges turning upward or bubbling in the middle mean the material suffers from severe moisture or heat damage."
          },
          {
            "snippet": "Granule loss: Dark, sand-like granules collecting in your gutters show that your shingles have lost their UV-blocking layer."
          },
          {
            "snippet": "Missing or cracked shingles:\nHigh winds or brittle aging can tear tabs away, exposing the vulnerable underlayment beneath."
          },
          {
            "snippet": "Sagging roof deck: A wavy or drooping roof line points to trapped moisture and rotted structural plywood."
          },
          {
            "snippet": "Indoor leaks or stains:\nWater spots on top-floor ceilings or dampness in the attic mean water is already passing through the barrier."
          }
        ],
        "reference_indexes": [
          1,
          2,
          3,
          4,
          5
        ]
      },
