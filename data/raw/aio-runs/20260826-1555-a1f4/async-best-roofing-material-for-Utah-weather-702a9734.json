        "type": "list",
        "list": [
          {
            "snippet": "Architectural Asphalt Shingles:",
            "list": [
              {
                "snippet": "Cost:\n\n$4.50 \u2013 $8.50 per sq. ft."
              },
              {
                "snippet": "Pros: Most affordable, highly versatile, and handles typical valley weather with 110\u2013130 mph wind ratings. Look for Class 3 or Class 4 impact resistance for hail protection (such as GAF Timberline HDZ\nGo to product viewer dialog for this item.\n).",
                "snippet_links": [
                  {
                    "text": "GAF Timberline HDZ Go to product viewer dialog for this item.",
                    "link": "https://www.google.com/search?ibp=oshop&prds=pvt:hg,pvo:48,mid:576462854052575341,imageDocid:14053369744525798508,gpcid:168797630363528168,headlineOfferDocid:6581823586769507620,catalogid:12224535178705260989,productDocid:13108363589488220180,rds:PC_168797630363528168%7CPROD_PC_168797630363528168&q=product&sa=X&ved=2ahUKEwi2wvOO1b6WAxVcHTQIHTWaOJsQxa4PegoIAggACAAIExAH"
                  }
                ]
              },
              {
                "snippet": "Best For: Standard suburban and valley homes."
              }
            ],
            "reference_indexes": [
              2,
              3,
              4
            ]
          },
          {
            "snippet": "Standing Seam Metal Roofing:",
            "list": [
              {
                "snippet": "Cost:\nHigher upfront (2-3x asphalt), but lasts 50\u201370 years."
              },
              {
                "snippet": "Pros: Sheds heavy snow effortlessly, prevents ice dams, withstands 140\u2013180 mph winds, and reflects intense summer heat."
              },
              {
                "snippet": "Best For:\nMountain communities and elevations above 5,000 feet (like Park City or Heber City)."
              }
            ],
            "reference_indexes": [
              5
            ]
          },
          {
            "snippet": "Concrete and Clay Tile:",
            "list": [
              {
                "snippet": "Cost:\n$10 \u2013 $25 per sq. ft."
              },
              {
                "snippet": "Pros: Exceptional lifespan (50\u2013100 years) and great fire resistance. Concrete handles freeze-thaw cycles better than clay in northern Utah."
              },
              {
                "snippet": "Best For:\nHomes with reinforced framing needing a unique aesthetic or desert-style architecture."
              }
            ]
          }
        ],
