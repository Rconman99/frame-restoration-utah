          0,
          1,
          2,
          3
        ]
      },
      {
        "type": "heading",
        "snippet": "Cost by Roofing Material"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Asphalt Shingles: $3.50 \u2013 $8.25 per square foot ($8,000 \u2013 $16,500 total)"
          },
          {
            "snippet": "Metal Roofing:\n$6.00 \u2013 $17.00 per square foot ($16,000 \u2013 $34,000 total)"
          },
          {
            "snippet": "Tile Roofing: $6.30 \u2013 $15.00 per square foot ($20,000 \u2013 $40,000+ total)"
          },
          {
            "snippet": "Slate / Premium Designer:\n$15.00 \u2013 $31.00+ per square foot ($35,000 \u2013 $54,000 total)"
          }
        ],
        "reference_indexes": [
