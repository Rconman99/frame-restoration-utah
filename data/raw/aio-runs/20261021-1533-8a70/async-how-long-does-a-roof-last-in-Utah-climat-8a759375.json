          1,
          2
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifespan by Roofing Material in Utah"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "3-Tab Asphalt Shingles: 15\u201320 years"
          },
          {
            "snippet": "Architectural / Dimensional Shingles: 22\u201330 years"
          },
          {
            "snippet": "Metal Roofing (Steel/Aluminum): 40\u201370 years"
          },
          {
            "snippet": "Concrete or Clay Tile: 50\u2013100 years"
          },
          {
            "snippet": "Rubber / Flat Roofs (EPDM, TPO, PVC): 20\u201335 years",
            "reference_indexes": [
              0,
