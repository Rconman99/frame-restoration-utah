      {
        "type": "list",
        "list": [
          {
            "snippet": "Free Contractor Inspection: $0 \u2014 Many local Utah roofing companies offer complimentary visual assessments, especially when evaluating snow load stress, UV wear, or post-storm hail damage.",
            "reference_indexes": [
              1,
              3,
              4
            ]
          },
          {
            "snippet": "Standard Visual Inspection: $150\u2013$300 \u2014 A hands-on physical roof check by an independent inspector or general home inspector .",
            "reference_indexes": [
              2,
              5
            ]
          },
          {
            "snippet": "Aerial Drone Inspection: $110\u2013$400 \u2014 Safe, tech-assisted imaging to spot cracked tiles or missing shingles without walking on steep Utah pitches .",
            "reference_indexes": [
              2
            ]
          },
          {
            "snippet": "Infrared / Thermal Inspection: $400\u2013$600 \u2014 Specialized scanning to detect hidden moisture or insulation loss beneath the roofing surface .",
            "reference_indexes": [
              2
            ]
          },
          {
            "snippet": "Detailed Real Estate Report: $200\u2013$500+ \u2014 Comprehensive documentation often requested during a home purchase or an insurance dispute .",
            "reference_indexes": [
              0,
