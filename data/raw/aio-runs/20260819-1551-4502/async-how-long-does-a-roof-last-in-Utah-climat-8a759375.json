          2,
          3
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifespan by Material"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "3-tab asphalt shingles: 12 to 18 years."
          },
          {
            "snippet": "Architectural/dimensional shingles:\n20 to 30 years."
          },
          {
            "snippet": "Impact-resistant shingles: 30 to 40 years."
          },
          {
            "snippet": "Metal roofing (standing seam):\n40 to 70 years."
          },
          {
            "snippet": "Concrete or clay tile: 50 to 100 years."
          }
        ],
        "reference_indexes": [
          4,
          5,
          6,
          7
        ]
      },
      {
        "type": "heading",
        "snippet": "Why Utah's Climate Impacts Roofs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Intense UV rays: High elevations mean stronger ultraviolet light, which bakes and dries out asphalt shingles faster."
          },
          {
            "snippet": "Freeze-thaw cycles:\nMelting snow and freezing night temperatures cause water to expand in cracks, leading to loose materials and ice dams."
          },
          {
            "snippet": "Heavy snow loads: Prolonged snow weight stresses weak structural supports and aging shingle granules."
          },
          {
            "snippet": "Temperature swings:\nRapid shifts from hot summer days to freezing nights make roofing materials expand and contract rapidly."
          }
        ],
        "reference_indexes": [
          8
        ]
      },
