      {
        "type": "heading",
        "snippet": "How Utah's Climate Affects Your Roof"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Intense UV & Temperature Swings: High altitude and dry summer sun accelerate shingle granule loss and cause expansion/contraction cracking.",
            "reference_indexes": [
              10
            ]
          },
          {
            "snippet": "Snow Loads & Ice Dams: Heavy mountain snow adds weight stress, while warm attics can melt snow that refreezes at roof edges, pushing water under shingles.",
            "reference_indexes": [
              4
            ]
          },
          {
            "snippet": "Freeze-Thaw Cycles: Daytime melting and nighttime freezing expand small cracks in roofing materials and flashing.",
            "reference_indexes": [
              4
            ]
          }
        ]
      },
