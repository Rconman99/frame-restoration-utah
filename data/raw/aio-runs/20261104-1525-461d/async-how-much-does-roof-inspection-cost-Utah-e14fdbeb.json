      {
        "type": "paragraph",
        "snippet": "In Utah, a professional roof inspection typically costs between $150 and $400, with most homeowners spending an average of $230 to $260. However, the exact price depends heavily on you need the inspection and how it is conducted.",
        "snippet_highlighted_words": [
          "between $150 and $400"
        ],
        "reference_indexes": [
          0,
          1,
          2
        ]
      },
