  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Review your denial letter and insurance policy immediately to find the exact reason for the rejection and any appeal deadlines.",
        "snippet_highlighted_words": [
          "Review your denial letter and insurance policy immediately to find the exact reason for the rejection and any appeal deadlines"
        ]
      },
      {
        "type": "paragraph",
        "snippet": "A denied roof claim is not the final word. You can take a step-by-step approach to contest the decision."
      },
      {
        "type": "heading",
        "snippet": "Immediate Actions"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Protect the roof: Cover leaks with a tarp to prevent more damage, but do not start major permanent repairs yet."
          },
          {
            "snippet": "Save receipts: Keep records of any emergency supplies or temporary fixes."
          },
          {
            "snippet": "Get your file: Request your full claim file from the insurance company, including the adjuster's notes and photos."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Gather Evidence"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Get an independent inspection: Hire an independent, licensed roofing contractor or a specialized inspector to evaluate the roof and write a detailed report."
          },
          {
            "snippet": "Collect local weather data: Find official weather reports or hail maps for the date of the storm."
          },
          {
            "snippet": "Take new photos: Shoot clear, timestamped close-ups and wide shots of the damage."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "File an Appeal"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Write a formal dispute letter: State clearly why the denial is wrong, include your policy and claim numbers, and attach your new evidence."
          },
          {
            "snippet": "Request a re-inspection: Ask the insurance company to send a second adjuster or a different inspector to look at the property again."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Get Professional Help"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Hire a public adjuster: Bring in a licensed professional who works for you\u2014not the insurance company\u2014to negotiate the claim."
          },
          {
            "snippet": "Contact state regulators: File a complaint with your state's department of insurance if you suspect unfair claim handling."
          },
          {
            "snippet": "Consult an attorney: Speak with an insurance lawyer if the repair costs are very high or the company acts in bad faith."
          }
        ]
      },
      {
        "type": "paragraph",
