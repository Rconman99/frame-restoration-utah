      {
        "type": "paragraph",
        "snippet": "When comparing local quotes from contractors like\nIWC Roofing Utah\n\nor Sky Ridge Roofing, keep an eye out for these localized cost factors:",
        "snippet_links": [
          {
            "text": "IWC Roofing Utah",
            "link": "https://iwcroofing.com/utah/pricing"
          }
        ]
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Ice and Water Shields: Utah building codes frequently require extra waterproof underlayment along eaves and valleys to prevent ice damming from snowmelt. This can add $1,000 to $4,000\n.",
            "reference_indexes": [
              8
            ]
          },
          {
            "snippet": "Roof Pitch: Steeply pitched roofs (common in mountain or high-snowfall areas) require special safety rigging, slowing down labor and increasing costs."
          },
          {
            "snippet": "Tear-off Layers: If your home has multiple old layers of shingles that need to be removed and disposed of, expect to add $1 to $3 per square foot for labor and dumping fees."
          }
        ],
        "reference_indexes": [
          9
        ]
