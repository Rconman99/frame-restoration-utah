    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "After a storm damages your roof, prioritize safety by staying off the roof. Inspect from the ground, document all visible damage with photos, and mitigate interior leaks using buckets or a temporary tarp. Next, contact a professional contractor for an inspection before filing an insurance claim.",
        "snippet_highlighted_words": [
          "prioritize safety by staying off the roof"
        ]
      },
      {
        "type": "paragraph",
        "snippet": "A visual guide on how to safely inspect your roof and property from the ground:",
        "video": {
          "link": "https://www.google.com/goto?url=CAESUwHuR6pNfQUuz9WMaduooPDFaq33Scdw_ObIRzXP1NAvT2FN6u8NX2k-wPPvP3YytJofS0xvqWLtlkLSVSaTuYk14FrvBJJeXDtYoFeJw7fCkQ6B",
          "thumbnail": "https://serpapi.com/images/i/R0lGODlhAQABAIAAAP_______yH5BAEKAAEALAAAAAABAAEAAAICTAEAOw.gif"
        }
      },
      {
        "type": "heading",
        "snippet": "Ensure Safety and Assess from the Ground"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Do not climb onto a wet, stormy, or damaged roof."
          },
          {
            "snippet": "Turn off electricity at the main breaker if you suspect water has reached the ceiling or wiring\n."
          },
          {
            "snippet": "Walk around the perimeter to look for missing shingles, dented gutters, fallen branches, or shingle granules in your downspouts."
          },
          {
            "snippet": "Check top-floor ceilings and your attic for active leaks, damp spots, or sagging drywall\n."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "A step-by-step tutorial on properly installing a temporary roof tarp to stop leaks:",
        "video": {
          "link": "https://www.google.com/goto?url=CAESUwHuR6pN0-KU_nwyTN2Yn5Sm1zpwF7NA3JnQOqcCIaiM0ta0Z06czKTwrMOOqqECMwLBa9Q5GufJE2GP2i_TKUuAGX4b0hLIrHhWfWRjphPVyJX4",
          "thumbnail": "https://serpapi.com/images/i/R0lGODlhAQABAIAAAP_______yH5BAEKAAEALAAAAAABAAEAAAICTAEAOw.gif"
        }
      },
      {
        "type": "heading",
        "snippet": "Prevent Further Interior Damage"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Move furniture, electronics, and valuable belongings away from active leaks."
          },
          {
            "snippet": "Place buckets under dripping water and mark wet areas to help contractors locate issues later\n."
          },
          {
            "snippet": "Cover small holes or missing shingle patches with a secure, waterproof tarp if you can do so safely."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Document and Contact Professionals"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Take clear, detailed photographs and videos of the exterior damage, fallen debris, and interior leaks."
          },
          {
            "snippet": "Note the date, time, and severity of the storm for your records\n."
          },
          {
            "snippet": "Call a reputable, local roofing professional to perform an objective damage assessment."
          },
          {
            "snippet": "Contact your homeowners insurance provider to start a claim once you have professional documentation of the damage\n."
          }
        ]
      }
    ],
