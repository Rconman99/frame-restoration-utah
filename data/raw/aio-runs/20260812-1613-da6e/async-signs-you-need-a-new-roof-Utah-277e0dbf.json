        ]
      },
      {
        "type": "heading",
        "snippet": "Exterior Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Old age: Most asphalt shingle roofs in Utah last about 20 to 25 years."
          },
          {
            "snippet": "Curling or buckling:\nShingle edges turn up from severe temperature changes."
          },
          {
            "snippet": "Missing or cracked pieces: High winds tear off loose tabs."
          },
          {
            "snippet": "Granule buildup:\nDark sand-like granules pile up in gutters."
          },
          {
            "snippet": "Moss and algae: Heavy growth traps moisture from snow."
          },
          {
            "snippet": "Sagging lines:\nThe roof deck dips, showing structural rot."
          }
        ],
        "reference_indexes": [
          3,
          4,
          5
        ]
      },
      {
        "type": "heading",
        "snippet": "Interior Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Water stains: Brown spots show on top ceilings or walls."
          },
          {
            "snippet": "Attic daylight:\nSun shines through broken boards."
          },
          {
            "snippet": "Wet insulation: Insulation feels damp or smashed down."
          },
          {
            "snippet": "Musty smells:\nMold grows from hidden roof leaks."
          }
        ]
      },
      {
