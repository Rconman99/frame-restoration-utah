        "list": [
          {
            "snippet": "Asphalt Shingles:",
            "list": [
              {
                "snippet": "Average Cost: $14,000 \u2013 $20,000 for a standard home (approx. $5.50 per square foot installed)."
              },
              {
                "snippet": "Upfront Investment: Lower initial cost; the most common residential choice across the Wasatch Front and rural Utah.",
                "reference_indexes": [
                  3,
                  4
                ]
              }
            ],
            "reference_indexes": [
              3,
