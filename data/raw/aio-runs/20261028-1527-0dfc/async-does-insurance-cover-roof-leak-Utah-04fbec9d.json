    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Standard homeowners insurance in Utah covers roof leaks only if they result from sudden and accidental damage, such as a severe windstorm, hail impact, lightning strike, or a fallen tree branch.",
        "snippet_highlighted_words": [
          "Standard homeowners insurance in Utah covers roof leaks only if they result from sudden and accidental damage"
        ],
        "reference_indexes": [
          0,
          1
        ]
      },
      {
        "type": "heading",
        "snippet": "What Is Covered"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Storm-related damage: Wind, hail, or heavy rain that directly punctures or damages the roof and causes interior water damage."
          },
          {
            "snippet": "Fallen debris: Trees or large branches crashing onto the roof during a storm."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "What Is Not Covered"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Wear and tear / old age: Leaks caused by aging shingles, deferred maintenance, or a deteriorating roof are considered the homeowner's responsibility.",
            "reference_indexes": [
              2
            ]
          },
          {
            "snippet": "Flooding or snowmelt: Water that pools on the ground and seeps in through the foundation, basement windows, or from heavy Utah snow runoff typically requires a separate flood insurance policy.",
            "reference_indexes": [
              3
            ]
          },
          {
            "snippet": "Earthquakes or earth movement: Standard policies exclude ground shifts or seismic activity."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "To help narrow down your situation, could you share:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "What caused the leak (a recent storm, aging roof, or something else)?"
          },
          {
            "snippet": "Where is the water showing up (just the ceiling, or down into the walls/basement)?"
          }
        ]
      }
    ],
