        "type": "heading",
        "snippet": "Which Should You Choose?"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Choose Asphalt Shingles if: You are working with a strict budget, plan to sell or move within the next 5 to 10 years, or prefer a traditional look that is quick and cheap to repair.",
            "reference_indexes": [
              0,
              9
            ]
          },
          {
            "snippet": "Choose Metal Roofing if: You plan to live in your \"forever home\" in a high-snow or high-wind area (such as the Wasatch Back or Northern Utah) and want a long-term, low-maintenance investment.",
            "reference_indexes": [
              0,
              10
            ]
          }
        ]
