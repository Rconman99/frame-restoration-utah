      {
        "type": "heading",
        "snippet": "What Utah Weather Tests a Roof On"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Intense UV Radiation: High altitude means stronger sun exposure that degrades lower-grade materials faster; lighter colors or reflective coatings help.",
            "reference_indexes": [
              2,
              7
            ]
          },
          {
            "snippet": "Heavy Snow & Ice Dams: Mountains and northern valleys face heavy accumulation; smooth metal or properly sloped/ventilated architectural shingles prevent trapped water and ice dams.",
            "reference_indexes": [
              1,
              3,
              7,
              8
            ]
          },
          {
            "snippet": "High Winds & Canyon Gusts: Microbursts and strong canyon winds require wind-rated shingles (110 mph or higher, like GAF HDZ rated up to 130 mph) or interlocking metal panels.",
            "reference_indexes": [
              1,
              5
            ]
          }
