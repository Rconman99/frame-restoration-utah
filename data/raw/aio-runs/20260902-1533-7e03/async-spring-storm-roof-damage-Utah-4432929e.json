      {
        "type": "heading",
        "snippet": "Common Signs of Roof Damage"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Missing or lifted shingles caused by strong wind gusts."
          },
          {
            "snippet": "Granules in gutters left behind after a heavy hail storm."
          },
          {
            "snippet": "Dented vents, flashing, or gutters from flying debris or large hail."
          },
          {
            "snippet": "Water stains on interior ceilings or walls."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "What to Do After a Storm"
      },
