  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Most residential roof replacements in Utah take one to three days for a standard asphalt shingle roof.",
        "snippet_highlighted_words": [
          "one to three days"
        ]
      },
      {
        "type": "heading",
        "snippet": "Timeline Breakdown"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "1 Day: Small to average-sized homes with a simple, single-story roofline and one layer of shingles."
          },
          {
            "snippet": "2 to 3 Days: Larger homes, steep pitches, multiple valleys or dormers, or complex roofing materials like metal panels."
          },
          {
            "snippet": "3 to 5 Days: Larger properties in Northern Utah, complex architectural layouts, or alternative materials like tile and synthetic slate."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Factors That Change the Timeline"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Size and Pitch: Steeper slopes require extra safety measures and slow down the crew."
          },
          {
            "snippet": "Hidden Damage: Finding rotting wood or damaged roof decking during the old shingle tear-off adds repair time."
          },
          {
            "snippet": "Weather: Rain, snow, high winds, or extreme cold can delay work, especially in mountain or northern regions of Utah."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you can tell me the approximate square footage and roof material (like asphalt or metal), I can give you a more specific timeline estimate."
      },
