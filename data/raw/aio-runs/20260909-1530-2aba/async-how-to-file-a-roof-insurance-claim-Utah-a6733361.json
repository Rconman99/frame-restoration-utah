  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "To file a roof insurance claim in Utah, contact your insurance provider promptly after a storm or damage occurs to open a claim and receive a claim number.",
        "snippet_highlighted_words": [
          "contact your insurance provider promptly after a storm or damage occurs to open a claim and receive a claim number"
        ]
      },
      {
        "type": "heading",
        "snippet": "Step-by-Step Filing Process"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Document the damage: Take clear, date-stamped photos and videos of the damaged roof, dented gutters, or fallen hailstones from the safety of the ground before making any changes."
          },
          {
            "snippet": "Prevent further damage: Make safe, temporary fixes like putting a tarp over a leaking section to stop water from ruining your home's interior. Save all receipts for emergency materials, as these costs are often paid back by your insurance."
          },
          {
            "snippet": "Review your policy: Check your deductible amount, coverage caps, and filing deadlines, which vary by insurance company."
          },
          {
            "snippet": "Get a professional inspection: Hire a licensed local contractor or inspector to perform a detailed assessment and write a damage report."
          },
          {
            "snippet": "File the claim: Call your insurance company or use their mobile app within 24 to 48 hours of discovering the damage to start the process."
          },
          {
            "snippet": "Meet the adjuster: Schedule a time for the insurance adjuster and your chosen roofing contractor to inspect the roof together so they can agree on the repair scope."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you'd like, let me know:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "What type of weather event caused the damage (hail, heavy snow, high winds)"
          },
          {
            "snippet": "When the storm happened"
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "I can help you prepare for the adjuster meeting or estimate your next steps."
      },
