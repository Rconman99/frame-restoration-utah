          },
          {
            "text": "GEICO Homeowners Insurance in Utah",
            "link": "https://www.geico.com/homeowners-insurance/states/ut/"
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you want, share:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Your insurance provider"
          },
          {
            "snippet": "Whether you are checking for a specific claim or shopping for a new policy"
          }
        ]
      },
