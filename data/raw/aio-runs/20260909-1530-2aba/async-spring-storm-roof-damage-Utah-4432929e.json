    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Spring storm roof damage in Utah is frequently driven by the transition from heavy winter snowpacks, freeze-thaw cycles, and high canyon winds that stress aging or vulnerable roofing systems .",
        "snippet_highlighted_words": [
          "frequently driven by the transition from heavy winter snowpacks, freeze-thaw cycles, and high canyon winds that stress aging or vulnerable roofing systems"
        ]
      },
      {
        "type": "heading",
        "snippet": "Common Causes of Spring Roof Damage in Utah"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Ice Dam Aftermath & Trapped Water: Residual winter ice dams melt during spring warming, but clogs in gutters and downspouts can force trapped water back under lifted or cracked shingles."
          },
          {
            "snippet": "Freeze-Thaw Cracking: Moisture entering tiny hairline cracks in asphalt shingles or flashing during winter expands as it freezes in early spring, widening gaps and creating active leaks."
          },
          {
            "snippet": "High Winds and Severe Storms: Sudden spring gales and severe gusts can loosen metal panels, tear away weakened flashing, or lift and rip off aged shingles."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Signs to Inspect After a Storm"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Granules in Gutters: Excessive black or colored granules accumulating in your drainage system signal that your shingles have been bruised or heavily weathered by hail and wind."
          },
          {
            "snippet": "Missing, Lifted, or Creased Shingles: Visibly misaligned, flapping, or missing sections of shingles."
          },
          {
            "snippet": "Attic Leaks and Stains: Water marks on top-floor ceilings or dampness along roof decking and insulation inside the attic."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Recommended Immediate Steps"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Prioritize Safety: Inspect your roof safely from the ground using binoculars; never climb onto a wet, stormy, or potentially compromised roof."
          },
          {
            "snippet": "Mitigate Interior Damage: Place buckets under active indoor drips and use emergency tarps if safe to prevent structural or flooring rot."
          },
          {
            "snippet": "Document Everything: Take clear, timestamped photographs of both interior water damage and exterior shingle or flashing issues."
          },
          {
            "snippet": "Schedule a Professional Assessment: Reach out for a reputable local inspection to evaluate structural integrity before filing or finalizing an insurance claim."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Would you like help with what to say when filing a homeowner's insurance claim for wind or water damage, or do you need tips on finding a licensed local roofing contractor in Utah?"
      },
