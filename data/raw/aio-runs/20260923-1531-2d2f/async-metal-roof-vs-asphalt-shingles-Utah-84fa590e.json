    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Asphalt shingles are best for lower upfront budgets, while metal roofs provide superior durability against Utah\u2019s heavy snow, ice, and high-elevation UV sun exposure.",
        "snippet_highlighted_words": [
          "Asphalt shingles are best for lower upfront budgets, while metal roofs provide superior durability against Utah\u2019s heavy snow, ice, and high-elevation UV sun exposure"
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Choosing the right roofing material for a Utah home requires balancing initial expenses, weather extremes, and long-term value."
      },
      {
        "type": "heading",
        "snippet": "Cost Comparison"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Asphalt Shingles: Costs range from $15,000 to $18,000 for a typical 2,000 to 2,500 square foot home . They offer a lower initial investment and faster installation."
          },
          {
            "snippet": "Metal Roofing: Costs range from $22,000 to $27,000 for exposed fastener panels, and start at $30,000 up to $45,000 for premium standing seam systems on a 2,000 to 2,500 square foot home. Higher upfront cost is offset by multi-decade longevity."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifespan and Weather Performance in Utah"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Asphalt Shingles: Lasts 15 to 30 years. Freeze-thaw cycles, high-elevation UV rays, and heavy winter snow can crack granules, lift edges, and shorten shingle life ."
          },
          {
            "snippet": "Metal Roofing: Lasts 40 to 70+ years. Metal naturally sheds heavy mountain snow efficiently, withstands high winds, reflects radiant heat from intense summer sun, and resists fire (Class A rating)."
          }
        ]
      },
