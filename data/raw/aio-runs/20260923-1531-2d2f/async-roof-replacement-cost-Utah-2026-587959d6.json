        "type": "list",
        "list": [
          {
            "snippet": "Roof Size & Pitch: Steeper slopes (8/12 pitch or higher) require specialized safety equipment and extra labor."
          },
          {
            "snippet": "Tear-Off Requirements: Removing old layers of shingles adds $1,500 to $4,500 in disposal and labor fees."
          },
          {
            "snippet": "Decking Repairs: Fixing rotted or damaged wood under the shingles costs an extra $70 to $120 per sheet."
          },
          {
            "snippet": "Location: Prices tend to run slightly higher in Salt Lake County and fast-growing mountain or resort areas compared to rural Utah counties."
          }
        ]
