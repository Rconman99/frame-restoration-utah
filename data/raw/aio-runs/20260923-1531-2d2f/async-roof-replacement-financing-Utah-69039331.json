  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "You can finance a roof replacement in Utah through contractor programs, local credit unions, or home equity loans.",
        "snippet_highlighted_words": [
          "contractor programs, local credit unions, or home equity loans"
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83d\udcb3 Contractor Financing"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "How it works: Partner lenders integrated directly with Utah roofers (like Bob Harvey Roofing or Legacy Roofing ).",
            "snippet_links": [
              {
                "text": "Legacy Roofing",
                "link": "https://www.legacyroofingutah.com/financing"
              }
            ]
          },
          {
            "snippet": "Pros: Often includes 0% APR promotional periods (e.g., 12 to 18 months) or fast soft-pull pre-qualifications."
          },
          {
            "snippet": ": Higher standard interest rates kick in after promotional windows expire (ranging from ~5% to nearly 9% APR)."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83c\udfe6 Home Equity (HELOC or Home Equity Loan)"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "How it works: Borrowing against the accumulated equity in your Utah home."
          },
          {
            "snippet": ": Lowest overall interest rates; interest may be tax-deductible if used for major home improvements."
          },
          {
            "snippet": "Cons: Requires an appraisal and weeks of processing time; uses your home as direct collateral."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83e\udd1d Local Credit Unions & Personal Loans"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "How it works: Unsecured home improvement loans from Utah-based credit unions or online lenders."
          },
          {
            "snippet": ": Faster than a HELOC with no home equity requirement; fixed monthly payments."
          },
          {
            "snippet": "Cons: Higher interest rates than secured loans depending on your credit score."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83d\udcca Financing Option Comparison"
