  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "You can get help and file a dispute regarding a claim settlement by contacting the Utah Insurance Department at 801-957-9305 or 800-439-3805.",
        "snippet_links": [
          {
            "text": "Utah Insurance Department",
            "link": "https://insurance.utah.gov/consumers/home-insurance/home-claims-info/"
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83d\udcc5 The Six-Step Claim Process"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Step 1: Get the damage documented before filing."
          },
          {
            "snippet": "Step 2: File the claim with your carrier."
          },
          {
            "snippet": "Step 3: Meet the adjuster (have your contractor present)."
          },
          {
            "snippet": "Step 4: Review the scope and your first check (ACV)."
          },
          {
            "snippet": "Step 5: Complete the build."
          },
          {
            "snippet": "Step 6: Get the final invoice and depreciation release."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83d\udca1 Policy Types: ACV vs. RCV"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "ACV (Actual Cash Value):",
            "list": [
              {
                "snippet": "Subtracts depreciation for roof age ."
              },
              {
                "snippet": "Results in smaller initial payouts for older roofs."
              }
            ]
          },
          {
            "snippet": "RCV (Replacement Cost Value):",
            "list": [
              {
                "snippet": "Covers full replacement cost minus your deductible ."
              },
              {
                "snippet": "Preferred for avoiding steep out-of-pocket costs."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "\u26a0\ufe0f Important Utah Rules & Warnings"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Deductibles: Contractors waiving or covering your deductible is considered insurance fraud under Utah law."
          },
          {
            "snippet": "Timeline: Most claims run four to eight weeks from start to finish."
          },
          {
            "snippet": "Disputes: The Utah Insurance Department regulates insurers but cannot act as a court to force payment."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "To help me give you more specific guidance, could you share:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "What kind of damage occurred (hail, wind, or wear and tear)?"
          },
          {
            "snippet": "Whether you have an ACV or RCV policy?"
          }
        ]
      }
    ],
