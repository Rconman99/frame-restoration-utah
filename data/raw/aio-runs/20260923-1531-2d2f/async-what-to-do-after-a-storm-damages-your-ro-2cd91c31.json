  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Prioritize personal safety and mitigate further interior water damage before documenting conditions and calling professionals.",
        "snippet_links": [
          {
            "text": "mitigate further interior water damage",
            "link": "https://ridgeline-roofing.com/news/what-to-do-after-your-roof-is-hit-by-a-severe-storm/"
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Immediate Safety and Protection"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Stay off the roof: Wet surfaces, loose granules, and hidden structural damage make climbing dangerous."
          },
          {
            "snippet": "Check for hazards: Watch out for downed power lines, broken glass, and unstable structures around the property."
          },
          {
            "snippet": "Stop indoor leaks: Place buckets or plastic bins under active drips, and move furniture or valuables away from the water."
          },
          {
            "snippet": "Relieve bulging ceilings: Poke a small hole at the lowest point of a sagging ceiling to drain trapped water into a single bucket."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Document the Damage"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Take photos first: Photograph wide and close-up views of missing shingles, dented gutters, and indoor stains before doing any major cleanup or tarping."
          },
          {
            "snippet": "Check the attic: Look for damp insulation, dripping water, or daylight showing through the roof boards."
          },
          {
            "snippet": "Record details: Write down the date, time, and specific type of severe weather (such as hail or high winds)."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Professional Inspections and Insurance"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Cover temporary damage: Install a heavy-duty tarp or hire an emergency service to prevent more water from entering. Save all receipts for reimbursement."
          },
          {
            "snippet": "Call a local roofer: Schedule a professional roof assessment to find hidden damage that is not visible from the ground.",
            "snippet_links": [
              {
                "text": "professional roof assessment",
                "link": "https://stonebrookexterior.com/"
              }
            ]
          },
          {
            "snippet": "File your claim: Contact your insurance provider with your photos, notes, and contractor notes to open a formal claim."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "To help tailor this advice, would you like more details on handling an insurance adjuster meeting, choosing a local contractor, or performing temporary tarping?"
      }
    ],
