  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Most residential roof replacements in Utah take 1 to 3 days for standard asphalt shingles on an average-sized home. Larger or more complex projects can stretch to 3 to 5 days.",
        "snippet_highlighted_words": [
          "1 to 3 days"
        ]
      },
      {
        "type": "heading",
        "snippet": "Timeline by Project Type"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Standard Asphalt Shingle (1,500\u20132,500 sq. ft.): 1 to 2 days."
          },
          {
            "snippet": "Large or Steep/Complex Roofs: 2 to 4 days (multi-story, steep pitch, many valleys or dormers)."
          },
          {
            "snippet": "Metal Roofing (Standing Seam): 3 to 5 days, as panels require individual measuring and fastening."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Factors That Change the Timeline"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Tear-off layers: Removing multiple old layers of shingles adds extra time."
          },
          {
            "snippet": "Decking damage: Replacing rotted or soft plywood underneath the shingles adds half a day to 2 days."
          },
          {
            "snippet": "Weather delays: Mountain weather shifts fast; unexpected rain or snow halts work safely until conditions dry."
          }
        ]
      }
    ],
