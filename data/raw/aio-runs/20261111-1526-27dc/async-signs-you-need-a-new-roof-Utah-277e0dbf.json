  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "You need a new roof in Utah if your asphalt shingle roof is 20 or more years old, or if you notice curling, cracking, or missing shingles caused by Utah's intense sun exposure and extreme freeze-thaw cycles.",
        "snippet_highlighted_words": [
          "if your asphalt shingle roof is 20 or more years old, or if you notice curling, cracking, or missing shingles caused by Utah's intense sun exposure and extreme freeze-thaw cycles"
        ],
        "reference_indexes": [
          0,
          1,
          2
        ]
      },
      {
        "type": "heading",
        "snippet": "Exterior Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Curling, Clawing, or Buckling Shingles: The edges of shingles turn upward or the centers pop up due to extreme temperature swings and UV damage.",
            "reference_indexes": [
              0,
              1,
              2
            ]
          },
          {
            "snippet": "Cracked or Missing Shingles: Thermal expansion and contraction or heavy mountain winds leave bare spots and expose the underlayment.",
            "reference_indexes": [
              2
            ]
          },
          {
            "snippet": "Excessive Granule Loss: Piles of sand-like asphalt granules in your gutters or downspouts mean the protective layer of your shingles has worn away.",
            "reference_indexes": [
              0,
              3
            ]
          },
          {
            "snippet": "Cracked Roof Vents or Flashing: Plastic roof vents and metal chimney/skylight flashings crack or deteriorate from intense sun and weather exposure.",
            "reference_indexes": [
              3,
              4
            ]
          },
          {
            "snippet": "Sagging Roof Deck: A drooping or uneven roofline points to structural weakening, often accelerated by heavy Utah winter snow loads.",
            "reference_indexes": [
              5,
              6
            ]
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Interior and Attic Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Water Stains on Ceilings or Walls: Brown streaks, damp patches, or peeling paint indicate active leaks getting past the outer barrier."
          },
          {
            "snippet": "Daylight or Moisture in the Attic: Seeing light through the roof boards, or detecting musty odors and mold, means moisture is getting trapped inside your home.",
            "reference_indexes": [
              2,
              5,
              7,
              8,
              9
            ]
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Utah-Specific Factors"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Age: Standard asphalt shingle roofs in Utah typically last 20 to 30 years, while metal systems like standing seam can last 40 to 70 years.",
            "reference_indexes": [
              6
            ]
          },
          {
            "snippet": "Weather Stress: The combination of hot summers, sub-zero winters, ice dams, and heavy snow loads forces materials to age faster than in milder climates.",
            "reference_indexes": [
              0,
              1,
              6
            ]
          }
        ]
      },
      {
        "type": "paragraph",
