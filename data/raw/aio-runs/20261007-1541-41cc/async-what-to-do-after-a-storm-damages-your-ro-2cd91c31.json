    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Stay safe on the ground and do not climb onto a wet or unstable storm-damaged roof.",
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Immediate Safety and Protection"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Check the interior: Look for active leaks, wet insulation, or sagging ceilings in your attic and top floors."
          },
          {
            "snippet": "Stop further water damage: Move furniture, rugs, and electronics away from drips, and place buckets to catch water."
          },
          {
            "snippet": "Prevent more exposure : Hire a professional to install an emergency tarp over open areas so rain does not ruin your walls and floors."
          }
        ],
        "reference_indexes": [
          0,
          1
        ]
      },
      {
        "type": "heading",
        "snippet": "Document the Damage"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Take photos and videos: Capture wide and close-up views of missing shingles, dented gutters, fallen branches, and indoor water stains before cleaning up ."
          },
          {
            "snippet": "Write down storm details: Note the exact date, time, and type of weather (such as heavy wind, hail, or a fallen tree)."
          }
        ],
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Contact Professionals and Insurance"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Review your policy: Locate your homeowners insurance documents and check your deductible before you call."
          },
          {
            "snippet": "File an insurance claim: Report the storm damage to your insurance company promptly."
          },
          {
            "snippet": "Hire a local roofer : Choose a trusted local contractor to inspect the roof, write a repair report, and meet your insurance adjuster on-site."
          }
        ],
        "reference_indexes": [
          0,
          2,
          3
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you want, tell me:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "What type of weather caused the damage (wind, hail, or a tree)?"
          },
          {
            "snippet": "Are you seeing active water leaks inside your home right now?"
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "I can help you prepare a checklist for your insurance call."
      }
    ],
