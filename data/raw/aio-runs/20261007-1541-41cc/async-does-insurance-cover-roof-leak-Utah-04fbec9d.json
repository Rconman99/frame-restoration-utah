  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Homeowners insurance in Utah covers a roof leak only if a sudden, accidental covered peril (like a severe windstorm, hail, or a falling tree branch) caused the damage.",
        "snippet_highlighted_words": [
          "Homeowners insurance in Utah covers a roof leak only if a sudden, accidental covered peril"
        ],
        "reference_indexes": [
          0,
          1
        ]
      },
      {
        "type": "heading",
        "snippet": "\u2705 Covered Causes"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Storms and Wind: High winds lifting or tearing off shingles, allowing water to enter.",
            "reference_indexes": [
              0,
              1
            ]
          },
          {
            "snippet": "Hail: Hail bruising or cracking shingles and compromising the waterproof seal.",
            "reference_indexes": [
              0,
              1
            ]
          },
          {
            "snippet": "Falling Objects: Tree branches or debris puncturing the roof during a severe weather event.",
            "reference_indexes": [
              1,
              2
            ]
          },
          {
            "snippet": "Interior Water Damage: Resulting directly from a hole or breach created by a covered storm."
          }
        ],
        "reference_indexes": [
          1
        ]
      },
      {
        "type": "heading",
        "snippet": "\u26a0\ufe0f Excluded Causes"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Wear and Tear: Leaks from old age or standard roof deterioration.",
            "reference_indexes": [
              3,
              4
            ]
          },
          {
            "snippet": "Poor Maintenance: Ignored missing shingles, cracked flashing, or rotted wood.",
            "reference_indexes": [
              2,
              5
            ]
          },
          {
            "snippet": "Neglect or Delay: Damage worsening over months because it was left unaddressed.",
            "reference_indexes": [
              6
            ]
          },
          {
            "snippet": "Roof Age: Roofs over 20 years old may only qualify for \"Actual Cash Value\" payouts (factoring in depreciation) rather than full replacement cost."
          }
        ],
        "reference_indexes": [
          4,
          7
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83d\udca1 What to Do Next"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Mitigate further damage: Place a tarp over the leaking area immediately to prevent indoor flooding or mold."
          },
          {
            "snippet": "Document the event: Note the date of the local storm and take photos of the interior water damage and exterior roof issues."
          },
          {
            "snippet": "Get a professional inspection: Hire a licensed Utah roofing contractor to inspect hidden damage around flashing and seals before calling your insurer.",
            "reference_indexes": [
              0,
              2,
              8
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Further Exploration:"
      },
